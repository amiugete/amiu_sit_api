<service>
  <id>fastapi-service-prod</id>
  <name>FastAPI Service prod</name>
  <description>Servizio FastAPI prod con WinSW</description>
  <!-- Definizione variabile di ambiente per la root -->
  <env name="APP_ROOT" value="C:\produzione\amiu_sit_api" />
  <!-- Uso della variabile per i percorsi -->
  <executable>%APP_ROOT%\.venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn main:app --host 0.0.0.0 --port 8002 --workers 4</arguments>
  <workingdirectory>%APP_ROOT%</workingdirectory>
  <priority>Normal</priority>
  <stoptimeout>15 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <startmode>Automatic</startmode>
  <waithint>15 sec</waithint>
  <sleeptime>1 sec</sleeptime>
  <log mode="roll-by-time"> 
    <!-- Uso della variabile per la directory dei log -->
    <logpath>%APP_ROOT%\logs</logpath>
    <workingdirectory>%APP_ROOT%</workingdirectory>
    <period>1</period> <pattern>yyyyMMdd</pattern>  <keepFiles>10</keepFiles>
  </log>
</service>
